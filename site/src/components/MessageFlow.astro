---
// Sequence diagram of one A2G session: session → decide (→ provider) → execute → report, telemetry alongside.
const X = { game: 110, service: 400, provider: 650 };
const steps = [
	{ y: 110, from: 'game', to: 'service', label: 'POST /v1/session', note: 'protocol version + manifest', n: 1 },
	{ y: 165, from: 'service', to: 'game', label: '{ ok }', dashed: true },
	{ y: 235, from: 'game', to: 'service', label: 'POST /v1/decide', note: 'epoch, world, entities[≤16]', n: 2 },
	{ y: 290, from: 'service', to: 'provider', label: 'one typed question per entity', note: '+ entity memory' },
	{ y: 345, from: 'provider', to: 'service', label: 'chosen action', dashed: true },
	{ y: 395, from: 'service', to: 'game', label: '{ epoch, decisions[] }', dashed: true },
	{ y: 510, from: 'game', to: 'service', label: 'POST /v1/report', note: 'executed · blocked · expired', n: 4 },
	{ y: 580, from: 'game', to: 'service', label: 'POST /v1/telemetry', note: 'every ~1 s, in every mode', n: 5 },
];
const lanes = [
	{ key: 'game', title: 'Game', sub: 'SDK + adapter' },
	{ key: 'service', title: 'Decision service', sub: 'reference: Python' },
	{ key: 'provider', title: 'Model provider', sub: 'reference: OpenAI' },
];
---

<figure class="flow not-content">
	<svg viewBox="0 0 760 620" role="img" aria-labelledby="flow-title">
		<title id="flow-title">A2G message flow between game, decision service and model provider</title>
		<defs>
			<marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" class="head"></path>
			</marker>
		</defs>

		{lanes.map((lane) => (
			<g>
				<rect x={X[lane.key] - 85} y="12" width="170" height="52" rx="10" class="lane-box" />
				<text x={X[lane.key]} y="35" class="lane-title">{lane.title}</text>
				<text x={X[lane.key]} y="53" class="lane-sub">{lane.sub}</text>
				<line x1={X[lane.key]} y1="64" x2={X[lane.key]} y2="605" class="lifeline" />
			</g>
		))}

		<rect x={X.game - 95} y="425" width="190" height="52" rx="8" class="action" />
		<text x={X.game} y="446" class="action-title">3 · validate & execute</text>
		<text x={X.game} y="464" class="action-sub">or run native AI (fallback)</text>

		{steps.map((s) => {
			const x1 = X[s.from];
			const x2 = X[s.to];
			const mid = (x1 + x2) / 2;
			return (
				<g>
					<line x1={x1} y1={s.y} x2={x2 + (x2 > x1 ? -4 : 4)} y2={s.y} class={s.dashed ? 'msg reply' : 'msg'} marker-end="url(#flow-arrow)" />
					{s.n && <circle cx={x1 + (x2 > x1 ? 14 : -14)} cy={s.y - 13} r="9" class="badge" />}
					{s.n && <text x={x1 + (x2 > x1 ? 14 : -14)} y={s.y - 9.5} class="badge-text">{s.n}</text>}
					<text x={mid} y={s.y - 8} class={s.dashed ? 'label reply-label' : 'label'}>{s.label}</text>
					{s.note && <text x={mid} y={s.y + 16} class="note">{s.note}</text>}
				</g>
			);
		})}
	</svg>
</figure>

<style>
	.flow {
		margin: 2rem 0;
		overflow-x: auto;
	}
	svg {
		display: block;
		width: 100%;
		min-width: 34rem;
		height: auto;
		font-family: var(--sl-font);
	}
	.lane-box {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	.lane-title {
		fill: var(--sl-color-white);
		font-size: 15px;
		font-weight: 600;
		text-anchor: middle;
	}
	.lane-sub {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		text-anchor: middle;
	}
	.lifeline {
		stroke: var(--sl-color-gray-5);
		stroke-dasharray: 3 5;
	}
	.msg {
		stroke: var(--sl-color-accent);
		stroke-width: 1.8;
	}
	.reply {
		stroke: var(--sl-color-gray-3);
		stroke-dasharray: 5 4;
	}
	.head {
		fill: var(--sl-color-gray-2);
	}
	.label {
		fill: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: 12.5px;
		text-anchor: middle;
	}
	.reply-label {
		fill: var(--sl-color-gray-2);
	}
	.note {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		text-anchor: middle;
	}
	.badge {
		fill: var(--sl-color-accent);
	}
	.badge-text {
		fill: var(--sl-color-black);
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
	}
	.action {
		fill: var(--sl-color-accent-low);
		stroke: var(--sl-color-accent);
	}
	.action-title {
		fill: var(--sl-color-white);
		font-size: 13px;
		font-weight: 600;
		text-anchor: middle;
	}
	.action-sub {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
		text-anchor: middle;
	}
</style>
