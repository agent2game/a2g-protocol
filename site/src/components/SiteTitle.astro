---
// Wordmark: "Agent" in the UI face, a "2" bridge, and "Game" in pixels.
// Easter egg: five quick clicks on the spark give the visitor an extra life.
import Spark from './Spark.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
// "Game" drawn as pixel glyphs: 7 rows tall (cap height), lowercase on the bottom 5 rows.
const glyphs = [
	['.###.', '#...#', '#....', '#.###', '#...#', '#...#', '.###.'],
	['.....', '.....', '.###.', '....#', '.####', '#...#', '.####'],
	['.....', '.....', '##.#.', '#.#.#', '#.#.#', '#.#.#', '#.#.#'],
	['.....', '.....', '.###.', '#...#', '#####', '#....', '.###.'],
];
const game = glyphs.flatMap((rows, i) =>
	rows.flatMap((row, y) => [...row].map((cell, x) => ({ x: i * 6 + x, y, on: cell === '#' })).filter((p) => p.on)),
);
---

<a href={siteTitleHref} class="site-title" aria-label="Agent2Game home" translate="no">
	<Spark size={26} />
	<span class="word" aria-hidden="true"><span class="agent">Agent</span><span class="two">2</span><svg class="game" viewBox="0 0 23 7" shape-rendering="crispEdges">{game.map((p) => <rect x={p.x} y={p.y} width="1" height="1" />)}</svg></span>
	<span class="oneup" aria-hidden="true">1UP</span>
</a>

<script>
	const title = document.querySelector<HTMLAnchorElement>('.site-title');
	const spark = title?.querySelector('.spark');
	let clicks = 0;
	let timer: ReturnType<typeof setTimeout> | undefined;
	spark?.addEventListener('click', (event) => {
		clicks += 1;
		clearTimeout(timer);
		timer = setTimeout(() => (clicks = 0), 1200);
		if (clicks < 5) {
			event.preventDefault();
			return;
		}
		event.preventDefault();
		clicks = 0;
		title?.classList.remove('lifted');
		void title?.offsetWidth;
		title?.classList.add('lifted');
	});
</script>

<style>
	.site-title {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.site-title:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
		border-radius: 2px;
	}
	.word {
		display: flex;
		align-items: baseline;
		font-size: 1.3rem;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.agent {
		font-weight: 650;
	}
	.two {
		margin: 0 0.12em 0 0.08em;
		font-weight: 400;
		color: var(--a2g-ai);
	}
	.game {
		/* 7 pixel rows = Inter's cap height, so the pixels sit on the same baseline as "Agent". */
		height: 0.73em;
		width: calc(0.73em * 23 / 7);
		fill: currentColor;
	}
	.oneup {
		position: absolute;
		left: 0;
		top: -0.2rem;
		font-family: var(--a2g-pixel);
		font-size: 0.75rem;
		color: var(--a2g-ai);
		opacity: 0;
		pointer-events: none;
	}
	.lifted .oneup {
		animation: oneup 1.1s steps(6) forwards;
	}
	@keyframes oneup {
		0% { opacity: 1; transform: translateY(0); }
		80% { opacity: 1; transform: translateY(-1.1rem); }
		100% { opacity: 0; transform: translateY(-1.3rem); }
	}
	@media (max-width: 30rem) {
		.word {
			font-size: 1.1rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lifted .oneup {
			animation: none;
			opacity: 1;
		}
	}
</style>
