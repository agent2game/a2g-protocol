---
// The A2G mark: a pixel four-point spark, like an item glint in old games and the "agent" spark.
// Drawn on an 11×11 grid; the centre pixel uses the AI colour.
interface Props {
	size?: number;
	class?: string;
}
const { size = 24, class: className } = Astro.props;
const rows = [
	'.....#.....',
	'.#...#...#.',
	'....###....',
	'....###....',
	'..#######..',
	'#####o#####',
	'..#######..',
	'....###....',
	'....###....',
	'.#...#...#.',
	'.....#.....',
];
const pixels = rows.flatMap((row, y) => [...row].map((cell, x) => ({ x, y, cell })).filter((p) => p.cell !== '.'));
---

<svg
	class:list={['spark', className]}
	width={size}
	height={size}
	viewBox="0 0 11 11"
	shape-rendering="crispEdges"
	aria-hidden="true"
	focusable="false"
>
	{pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" class={p.cell === 'o' ? 'core' : undefined} />)}
</svg>

<style>
	.spark {
		fill: currentColor;
		flex-shrink: 0;
	}
	.core {
		fill: var(--a2g-ai);
	}
</style>
